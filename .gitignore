# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Supabase
/supabase/.temp/
/supabase/.branches/
/supabase/logs/

# IDE
.idea/
.vscode/

# Local testing and scratch scripts
*.sql
!supabase/migrations/*.sql
!supabase/seed.sql
test*.js
test*.mjs
check*.js
write*.js
fix*.js
fix*.py
payload.json
ea_match.json
scratch_*.sql
temp_out/
*.txt
*.md
!README.md
!pre_launch_audit_report.md

# Exclude local test directories
test-ssr/
temp_out/
node_modules/

# Exclude specific temp JS files containing secrets or local tests
build-test.js
clean_fake_data.js
fetch_email.js
inject.js
integration-tests.js
pg_seed.js
pg_seed2.js
